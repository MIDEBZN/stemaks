---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-top">
    <div class="container">
      <div class="footer-grid">
        <!-- Col 1: Brand & Emergency -->
        <div class="footer-col brand-col">
          <div class="footer-logo">
            <div class="logo-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
              </svg>
            </div>
            <span class="logo-text">STEMAKS<span class="brand-dot">.</span></span>
          </div>
          <p class="brand-desc">
            Entreprise de plomberie et de chauffage agréée à Bruxelles, basée à Woluwe-Saint-Lambert. Interventions d'urgence 24/7, réparations de fuites, débouchages haute pression et rénovations sanitaires de haute qualité.
          </p>
          <div class="emergency-box">
            <span class="live-indicator"></span>
            <div>
              <div class="emergency-label">Assistance Urgence 24h/24 - 7j/7</div>
              <a href="tel:+3228804567" class="emergency-number">02 880 45 67</a>
            </div>
          </div>
        </div>

        <!-- Col 2: Services -->
        <div class="footer-col">
          <h3 class="footer-title">Nos Prestations</h3>
          <ul class="footer-links">
            <li><a href="/services#debouchage">Débouchage express canalisations</a></li>
            <li><a href="/services#fuites">Recherche & réparation de fuite d'eau</a></li>
            <li><a href="/services#chauffe-eau">Chauffe-eau, boiler & chauffage</a></li>
            <li><a href="/services#renovation">Rénovation de salle de bain</a></li>
            <li><a href="/services#robinetterie">Robinetterie, WC & sanitaires</a></li>
            <li><a href="/services#detartrage">Détartrage & adoucisseurs d'eau</a></li>
          </ul>
        </div>

        <!-- Col 3: Brussels Zones -->
        <div class="footer-col">
          <h3 class="footer-title">Zones d'Intervention</h3>
          <p class="footer-subtext">Déplacement express en moins de 30 min dans toutes les communes :</p>
          <ul class="footer-tags">
            <li><a href="/locations#woluwe-saint-lambert">Woluwe-Saint-Lambert (1200)</a></li>
            <li><a href="/locations#woluwe-saint-pierre">Woluwe-Saint-Pierre (1150)</a></li>
            <li><a href="/locations#etterbeek">Etterbeek (1040)</a></li>
            <li><a href="/locations#ixelles">Ixelles (1050)</a></li>
            <li><a href="/locations#schaerbeek">Schaerbeek (1030)</a></li>
            <li><a href="/locations#auderghem">Auderghem (1160)</a></li>
            <li><a href="/locations#bruxelles-centre">Bruxelles Centre (1000)</a></li>
            <li><a href="/locations#uccle">Uccle (1180)</a></li>
          </ul>
          <a href="/locations" class="view-all-link">Voir toutes les communes →</a>
        </div>

        <!-- Col 4: Contact & Office -->
        <div class="footer-col">
          <h3 class="footer-title">Coordonnées</h3>
          <ul class="contact-list">
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              <span>Avenue de Broqueville 120, 1200 Woluwe-Saint-Lambert, Bruxelles</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              <a href="tel:+3228804567">02 880 45 67</a>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              <a href="mailto:contact@stemaks-plomberie.be">contact@stemaks-plomberie.be</a>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              <span><strong>Urgences :</strong> 24h/24 & 7j/7<br/><strong>Secrétariat :</strong> Lun-Sam : 08h00 - 19h00</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="copyright">
        © {currentYear} <strong>Stemaks Plomberie Sprl</strong> — N° BCE : BE 0798.452.190. Tous droits réservés.
      </p>
      <div class="footer-badges">
        <span class="guarantee-pill">🛡️ Assurance RC Professionnelle</span>
        <span class="guarantee-pill">⭐ Plombier Agréé Bruxelles</span>
        <span class="guarantee-pill">⚡ Garantie Décennale</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--navy-950);
    color: var(--slate-300);
    margin-top: auto;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-top {
    padding-block: 4.5rem 3.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
      gap: 2.5rem;
    }
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.2rem;
  }

  .logo-icon {
    width: 38px;
    height: 38px;
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
    color: var(--white);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-text {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--white);
    letter-spacing: -0.02em;
  }

  .brand-dot {
    color: var(--accent);
  }

  .brand-desc {
    color: var(--slate-400);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .emergency-box {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    background: rgba(249, 115, 22, 0.1);
    border: 1px solid rgba(249, 115, 22, 0.3);
    padding: 0.85rem 1.1rem;
    border-radius: var(--radius-md);
  }

  .emergency-label {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--slate-300);
    letter-spacing: 0.03em;
  }

  .emergency-number {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--accent);
    display: block;
    line-height: 1.1;
  }

  .emergency-number:hover {
    color: #fdba74;
  }

  .footer-title {
    color: var(--white);
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 1.3rem;
    position: relative;
    padding-bottom: 0.5rem;
  }

  .footer-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 32px;
    height: 2px;
    background-color: var(--primary);
    border-radius: 2px;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-links a {
    color: var(--slate-400);
    font-size: 0.95rem;
    transition: color var(--transition-fast), transform var(--transition-fast);
    display: inline-block;
  }

  .footer-links a:hover {
    color: var(--white);
    transform: translateX(4px);
  }

  .footer-subtext {
    font-size: 0.88rem;
    color: var(--slate-400);
    margin-bottom: 1rem;
  }

  .footer-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .footer-tags a {
    display: inline-block;
    background: rgba(255, 255, 255, 0.06);
    color: var(--slate-300);
    font-size: 0.82rem;
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-tags a:hover {
    background: rgba(2, 132, 199, 0.2);
    border-color: var(--primary);
    color: var(--white);
  }

  .view-all-link {
    display: inline-block;
    font-size: 0.88rem;
    color: var(--primary);
    font-weight: 600;
  }

  .view-all-link:hover {
    text-decoration: underline;
  }

  .contact-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    color: var(--slate-400);
    font-size: 0.92rem;
  }

  .contact-list svg {
    color: var(--primary);
    flex-shrink: 0;
    margin-top: 3px;
  }

  .contact-list a {
    color: var(--slate-300);
  }

  .contact-list a:hover {
    color: var(--white);
  }

  .footer-bottom {
    background-color: #05080f;
    padding-block: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .footer-bottom-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
  }

  @media (min-width: 768px) {
    .footer-bottom-inner {
      flex-direction: row;
    }
  }

  .copyright {
    font-size: 0.85rem;
    color: var(--slate-500);
  }

  .footer-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .guarantee-pill {
    font-size: 0.78rem;
    background: rgba(255, 255, 255, 0.05);
    color: var(--slate-300);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
  }
</style>
