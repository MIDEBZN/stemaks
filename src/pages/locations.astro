---
import Layout from '../layouts/Layout.astro';

const communes = [
  {
    name: "Woluwe-Saint-Lambert",
    code: "1200",
    delay: "15 - 20 min",
    priority: true,
    desc: "Notre siège d'exploitation. Dépannage prioritaire sur Georges Henri, Tomberg, Marcel Thiry, Roodebeek et Heydenberg."
  },
  {
    name: "Woluwe-Saint-Pierre",
    code: "1150",
    delay: "15 - 20 min",
    priority: true,
    desc: "Intervention rapide sur Stockel, Place Montgomery, Avenue de Tervueren, Chant d'Oiseau et Sainte-Alix."
  },
  {
    name: "Kraainem & Wezembeek",
    code: "1950 / 1970",
    delay: "20 min",
    priority: false,
    desc: "Couverture immédiate de la périphérie est bruxelloise, Baron d'Huart, Reine Astrid et Quatre Bras."
  },
  {
    name: "Etterbeek",
    code: "1040",
    delay: "20 - 25 min",
    priority: true,
    desc: "Dépannage plomberie express à La Chasse, Place Jourdan, Quartier Européen, Merode et Arsenal."
  },
  {
    name: "Ixelles",
    code: "1050",
    delay: "20 - 25 min",
    priority: false,
    desc: "Service d'urgence à Place Flagey, Châtelain, Fernand Cocq, Cimetière d'Ixelles et ULB/VUB."
  },
  {
    name: "Schaerbeek",
    code: "1030",
    delay: "20 - 25 min",
    priority: false,
    desc: "Interventions rapides à Place Meiser, Dailly, Avenue Plasky, Parc Josaphat et Quartier des Fleurs."
  },
  {
    name: "Auderghem",
    code: "1160",
    delay: "20 - 25 min",
    priority: false,
    desc: "Plombier disponible à Herrmann-Debroux, Boulevard du Souverain, Val Duchesse et Rouge-Cloître."
  },
  {
    name: "Evere",
    code: "1140",
    delay: "20 min",
    priority: false,
    desc: "Débouchage et plomberie à Place Paduwa, Avenue Henri Conscience, Cimetière de Bruxelles et Bordet."
  },
  {
    name: "Bruxelles-Ville (Centre)",
    code: "1000",
    delay: "25 - 30 min",
    priority: false,
    desc: "Centre historique, Pentagone, Quartier des Sablons, Marolles, Grand-Place et Avenue Louise."
  },
  {
    name: "Uccle",
    code: "1180",
    delay: "25 - 30 min",
    priority: false,
    desc: "Dépannage d'urgence à Fort Jaco, Avenue Churchill, Observatoire, Saint-Job et Dieweg."
  },
  {
    name: "Saint-Gilles",
    code: "1060",
    delay: "25 min",
    priority: false,
    desc: "Interventions au Parvis de Saint-Gilles, Barrière, Avenue Louise, Prison et Quartier Horta."
  },
  {
    name: "Watermael-Boitsfort",
    code: "1170",
    delay: "25 min",
    priority: false,
    desc: "Plomberie sanitaire à Place Wiener, Cité Floréal, Keym et l'Orée de la Forêt de Soignes."
  },
  {
    name: "Forest",
    code: "1190",
    delay: "25 - 30 min",
    priority: false,
    desc: "Intervention rapide à Altitude 100, Parc de Forest, Wiels et Place Saint-Denis."
  },
  {
    name: "Jette",
    code: "1090",
    delay: "25 - 30 min",
    priority: false,
    desc: "Débouchage et fuite à Place Reine Astrid (Miroir), Hôpital Brugmann et UZ Brussel."
  },
  {
    name: "Ganshoren & Koekelberg",
    code: "1083 / 1081",
    delay: "25 - 30 min",
    priority: false,
    desc: "Couverture express près de la Basilique, Avenue de la Liberté et Charles-Quint."
  },
  {
    name: "Molenbeek & Anderlecht",
    code: "1080 / 1070",
    delay: "25 - 30 min",
    priority: false,
    desc: "Dépannage plomberie 24/7 sur Tour & Taxis, Gare de l'Ouest, Saint-Guidon et Westland."
  }
];
---

<Layout
  title="Zones d'Intervention Plomberie à Bruxelles & Woluwe-Saint-Lambert"
  description="Plombier basé à Woluwe-Saint-Lambert intervenant en moins de 30 minutes dans les 19 communes de Bruxelles. Débouchage, fuite et chauffe-eau d'urgence."
>
  <!-- Locations Page Header -->
  <section class="page-header">
    <div class="container text-center">
      <span class="badge badge-primary">Couverture Région Bruxelles-Capitale</span>
      <h1 class="page-title">Nos Zones d'Intervention à <span class="text-gradient">Bruxelles</span></h1>
      <p class="page-desc">
        Basés avenue de Broqueville à <strong>Woluwe-Saint-Lambert</strong>, nos véhicules d'intervention sillonnent toute la région bruxelloise pour vous dépanner en moins de 30 minutes, 24h/24 et 7j/7.
      </p>
      <div class="header-contact-badge">
        <span>📍 Base locale : Avenue de Broqueville 120, 1200 Woluwe-Saint-Lambert</span>
        <a href="tel:+3228804567" class="btn btn-accent btn-sm">📞 02 880 45 67</a>
      </div>
    </div>
  </section>

  <!-- Woluwe Spotlight Section -->
  <section class="section local-spotlight">
    <div class="container">
      <div class="spotlight-card">
        <div class="spotlight-grid">
          <div class="spotlight-content">
            <span class="badge badge-accent">Priorité Locale Numéro 1</span>
            <h2>Plombier à Woluwe-Saint-Lambert (1200)</h2>
            <p class="spotlight-lead">
              Notre siège étant implanté au cœur de la commune, nous sommes vos voisins directs. Nous garantissons une arrivée sur place en <strong>15 à 20 minutes maximum</strong> en cas de dégât des eaux ou canalisation bouchée.
            </p>

            <div class="woluwe-neighborhoods">
              <h4>Tous les quartiers de Woluwe-Saint-Lambert couverts :</h4>
              <div class="tags-cloud">
                <span class="loc-tag">Avenue Georges Henri</span>
                <span class="loc-tag">Quartier Tomberg</span>
                <span class="loc-tag">Roodebeek & Parc</span>
                <span class="loc-tag">Avenue Marcel Thiry</span>
                <span class="loc-tag">Avenue de Broqueville</span>
                <span class="loc-tag">Woluwe Shopping Center</span>
                <span class="loc-tag">Campus Alma / UCLouvain</span>
                <span class="loc-tag">Quartier Heydenberg</span>
                <span class="loc-tag">Boulevard de la Woluwe</span>
                <span class="loc-tag">Place Saint-Lambert</span>
              </div>
            </div>

            <div class="spotlight-cta">
              <a href="tel:+3228804567" class="btn btn-accent btn-lg btn-pulse">
                📞 Ligne Urgence Woluwe : 02 880 45 67
              </a>
              <a href="/contact" class="btn btn-outline">
                Demander un devis sans engagement
              </a>
            </div>
          </div>

          <div class="spotlight-stats">
            <div class="stat-pill">
              <span class="pill-number">< 20 min</span>
              <span class="pill-label">Temps d'arrivée moyen à Woluwe</span>
            </div>
            <div class="stat-pill">
              <span class="pill-number">0 €</span>
              <span class="pill-label">Frais de déplacement à Woluwe</span>
            </div>
            <div class="stat-pill">
              <span class="pill-number">24h / 7j</span>
              <span class="pill-label">Permanence continue même fériés</span>
            </div>
            <div class="stat-pill">
              <span class="pill-number">100%</span>
              <span class="pill-label">Agréé compagnies d'assurance</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Search / Filter Communes -->
  <section class="section bg-slate">
    <div class="container">
      <div class="section-title-wrap">
        <span class="badge badge-primary">Toutes nos communes</span>
        <h2>Interventions dans les 19 Communes de Bruxelles</h2>
        <p>Recherchez votre commune ou code postal pour vérifier nos délais d'arrivée estimés en temps réel.</p>
        
        <div class="search-commune-bar">
          <input 
            type="text" 
            id="commune-search" 
            class="form-control" 
            placeholder="Tapez le nom de votre commune ou code postal (ex: 1050, Ixelles, Schaerbeek...)" 
          />
        </div>
      </div>

      <div class="grid-3 communes-grid" id="communes-container">
        {communes.map((c) => (
          <div class={`card commune-card ${c.priority ? 'commune-featured' : ''}`} data-keywords={`${c.name} ${c.code} ${c.desc}`.toLowerCase()}>
            <div class="commune-header">
              <div>
                <span class="commune-postal">{c.code}</span>
                <h3 class="commune-name">{c.name}</h3>
              </div>
              <span class={`delay-badge ${c.priority ? 'delay-priority' : ''}`}>
                ⚡ {c.delay}
              </span>
            </div>
            <p class="commune-desc">{c.desc}</p>
            <div class="commune-footer">
              <a href="tel:+3228804567" class="commune-phone-link">
                Appeler : 02 880 45 67
              </a>
              <a href={`/contact?commune=${encodeURIComponent(c.name)}`} class="commune-action-link">
                Réserver →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Local Proximity Matters -->
  <section class="section">
    <div class="container">
      <div class="section-title-wrap">
        <span class="badge badge-primary">Pourquoi la proximité compte ?</span>
        <h2>Pourquoi Faire Appel à un Plombier Local à Bruxelles ?</h2>
      </div>

      <div class="grid-3">
        <div class="card">
          <div class="icon-box">⚡</div>
          <h3>Arrêter les Dégâts Immédiatement</h3>
          <p>Une fuite sur une canalisation sous pression déverse jusqu'à 3 000 litres d'eau par heure. Intervenir en 20 minutes au lieu de 2 heures divise par dix les coûts de réfection.</p>
        </div>

        <div class="card">
          <div class="icon-box">🚗</div>
          <h3>Véhicules Homologués LEZ Bruxelles</h3>
          <p>Toute la flotte Stemaks est 100% conforme à la Zone Basses Émissions (LEZ) bruxelloise. Nous circulons sans aucune restriction dans tous les quartiers pour vous secourir.</p>
        </div>

        <div class="card">
          <div class="icon-box">🏢</div>
          <h3>Parfaite Connaissance du Bâti Bruxellois</h3>
          <p>Maisons de maître 1900, immeubles modernistes ou résidences récentes : nous connaissons parfaitement la typologie des réseaux de plomberie bruxellois et leur dureté d'eau.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="cta-banner">
    <div class="container cta-banner-inner">
      <div class="cta-text">
        <span class="badge badge-accent">Où que vous soyez à Bruxelles</span>
        <h2>Un Problème de Plomberie ? Nous Sommes en Route.</h2>
        <p>Nos artisans plombiers sont prêts à partir immédiatement. Devis 100% gratuit et sans engagement.</p>
      </div>
      <div class="cta-action-group">
        <a href="tel:+3228804567" class="btn btn-accent btn-lg btn-pulse">
          📞 02 880 45 67
        </a>
        <a href="/contact" class="btn btn-white btn-lg">
          Formulaire de Contact
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background: radial-gradient(circle at 50% 0%, rgba(2, 132, 199, 0.1) 0%, transparent 70%);
    padding-top: 4rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid var(--slate-200);
  }

  .text-center {
    text-align: center;
  }

  .page-title {
    margin-top: 0.8rem;
    margin-bottom: 1rem;
  }

  .page-desc {
    max-width: 740px;
    margin-inline: auto;
    font-size: 1.15rem;
    color: var(--navy-600);
    margin-bottom: 1.5rem;
  }

  .header-contact-badge {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    background: var(--white);
    padding: 0.6rem 1.25rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--slate-200);
    box-shadow: var(--shadow-sm);
    font-weight: 600;
    font-size: 0.95rem;
  }

  /* Spotlight Woluwe */
  .local-spotlight {
    padding-top: 3.5rem;
  }

  .spotlight-card {
    background: linear-gradient(135deg, var(--navy-950) 0%, var(--navy-900) 100%);
    color: var(--white);
    border-radius: var(--radius-xl);
    padding: 2.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: var(--shadow-xl);
  }

  @media (min-width: 960px) {
    .spotlight-card {
      padding: 3.5rem;
    }
  }

  .spotlight-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .spotlight-grid {
      grid-template-columns: 1.5fr 1fr;
      gap: 4rem;
    }
  }

  .spotlight-content h2 {
    color: var(--white);
    margin-top: 0.8rem;
    margin-bottom: 1rem;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
  }

  .spotlight-lead {
    font-size: 1.15rem;
    color: var(--slate-300);
    margin-bottom: 1.8rem;
    line-height: 1.6;
  }

  .spotlight-lead strong {
    color: #38bdf8;
  }

  .woluwe-neighborhoods h4 {
    color: var(--white);
    font-size: 1rem;
    margin-bottom: 0.8rem;
  }

  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .loc-tag {
    background: rgba(255, 255, 255, 0.08);
    color: var(--slate-200);
    font-size: 0.825rem;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .spotlight-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .spotlight-cta .btn-outline {
    color: var(--white);
    border-color: rgba(255, 255, 255, 0.25);
  }

  .spotlight-cta .btn-outline:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .spotlight-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .stat-pill {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 1.5rem 1rem;
    border-radius: var(--radius-md);
    text-align: center;
  }

  .pill-number {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--accent);
    display: block;
    line-height: 1.1;
    margin-bottom: 0.3rem;
  }

  .pill-label {
    font-size: 0.8rem;
    color: var(--slate-400);
  }

  /* Search Bar */
  .search-commune-bar {
    max-width: 560px;
    margin: 2rem auto 0 auto;
  }

  .search-commune-bar input {
    font-size: 1.05rem;
    padding: 1rem 1.4rem;
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-md);
  }

  /* Communes Grid */
  .commune-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .commune-featured {
    border-color: var(--primary);
    background: linear-gradient(180deg, #f0f9ff 0%, var(--white) 100%);
  }

  .commune-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
  }

  .commune-postal {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--primary);
    background: var(--primary-light);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    margin-bottom: 0.3rem;
  }

  .commune-name {
    font-size: 1.25rem;
  }

  .delay-badge {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--navy-700);
    background: var(--slate-100);
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .delay-priority {
    background: var(--accent-light);
    color: var(--accent-hover);
  }

  .commune-desc {
    font-size: 0.92rem;
    color: var(--navy-600);
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }

  .commune-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid var(--slate-100);
  }

  .commune-phone-link {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--navy-900);
  }

  .commune-phone-link:hover {
    color: var(--accent);
  }

  .commune-action-link {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--primary);
  }

  .commune-action-link:hover {
    text-decoration: underline;
  }
</style>

<script>
  const searchInput = document.getElementById('commune-search') as HTMLInputElement | null;
  const cards = document.querySelectorAll('.commune-card');

  if (searchInput) {
    searchInput.addEventListener('input', () => {
      const query = searchInput.value.toLowerCase().trim();
      cards.forEach((card) => {
        const keywords = card.getAttribute('data-keywords') || '';
        if (keywords.includes(query)) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  }
</script>
