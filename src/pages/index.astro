---
import Layout from '../layouts/Layout.astro';
import PriceEstimator from '../components/PriceEstimator.astro';

const services = [
  {
    id: "debouchage",
    title: "Débouchage Express 24/7",
    desc: "WC bouché, évier, douche ou colonne générale d'immeuble. Débouchage mécanique au furet et hydrocurage haute pression.",
    icon: "🚿",
    price: "Dès 95 €",
    delay: "30 min"
  },
  {
    id: "fuites",
    title: "Recherche & Réparation de Fuite",
    desc: "Détection non-destructive par caméra thermique et récepteur acoustique. Rapport complet certifié pour votre assurance habitation.",
    icon: "🔍",
    price: "Dès 90 €",
    delay: "Urgence 24/7"
  },
  {
    id: "chauffe-eau",
    title: "Chauffe-eau & Boilers",
    desc: "Dépannage, remplacement et détartrage de chauffe-eau électrique et gaz. Partenaire agréé Bulex, Vaillant, Ariston, ACV.",
    icon: "🔥",
    price: "Dès 110 €",
    delay: "Même jour"
  },
  {
    id: "renovation",
    title: "Rénovation Salle de Bain",
    desc: "Création de douches à l'italienne, installation de meubles vasques, pose de WC suspendus Geberit et robinetterie moderne.",
    icon: "🛁",
    price: "Sur devis gratuit",
    delay: "Clé en main"
  },
  {
    id: "robinetterie",
    title: "Robinetterie & Tuyauterie",
    desc: "Remplacement de mitigeurs, robinets d'arrêt, réfection de tuyaux cuivre/multicouche, pose de réducteurs de pression d'eau.",
    icon: "🔧",
    price: "Dès 80 €",
    delay: "Rapide"
  },
  {
    id: "detartrage",
    title: "Détartrage & Adoucisseurs",
    desc: "Bruxelles possède une eau très calcaire (35°fH). Nous protégeons vos canalisations et appareils avec des adoucisseurs certifiés.",
    icon: "💧",
    price: "Dès 150 €",
    delay: "Sur RDV"
  }
];

const reviews = [
  {
    name: "Alexandre Dupont",
    commune: "Woluwe-Saint-Lambert (Avenue Georges Henri)",
    rating: 5,
    date: "Il y a 3 jours",
    comment: "Fuite importante sous l'évier de cuisine un dimanche matin. Le plombier Stemaks est arrivé en 22 minutes montre en main. Réparation propre, tarif annoncé à l'avance et facture détaillée pour mon assurance. Chapeau !"
  },
  {
    name: "Sophie Vanderberg",
    commune: "Woluwe-Saint-Pierre (Montgomery)",
    rating: 5,
    date: "Il y a 1 semaine",
    comment: "Débouchage de WC complètement engorgé. Travail impeccable avec caméra d'inspection pour vérifier la colonne. Très courtois et soigné, ils ont laissé la pièce plus propre qu'à leur arrivée !"
  },
  {
    name: "Marc Laurent",
    commune: "Etterbeek (Chasse)",
    rating: 5,
    date: "Il y a 2 semaines",
    comment: "Notre boiler Bulex est tombé en panne en plein hiver sans eau chaude. Diagnostic rapide, changement de la résistance le jour même. Tarifs clairs sans frais cachés. Je recommande à 100%."
  }
];

const faqs = [
  {
    q: "En combien de temps intervenez-vous à Woluwe-Saint-Lambert et Bruxelles ?",
    a: "Grâce à nos équipes basées directement à Woluwe-Saint-Lambert (Rue Abbé Jean Heymans), nous arrivons sur place en moins de 20 à 30 minutes pour toutes les urgences plomberie dans les 19 communes de Bruxelles."
  },
  {
    q: "Vos tarifs sont-ils annoncés avant le début des travaux ?",
    a: "Oui, absolument. Avant toute intervention, notre technicien établit un devis clair et transparent. Vous validez le montant avant que le travail ne commence. Aucun frais imprévu ni mauvaise surprise."
  },
  {
    q: "Êtes-vous agréé par les assurances belges pour les dégâts des eaux ?",
    a: "Oui. Stemaks est une entreprise agréée en Belgique. Après recherche et colmatage de fuite, nous vous fournissons un rapport technique détaillé conforme aux exigences de toutes les compagnies d'assurance (Axa, AG, Baloise, Ethias, etc.) pour votre remboursement."
  },
  {
    q: "Proposez-vous un service de plomberie d'urgence la nuit et le week-end ?",
    a: "Oui, notre permanence d'urgence est opérationnelle 24 heures sur 24 et 7 jours sur 7, y compris les dimanches et jours fériés, au 0485 81 39 39."
  }
];
---

<Layout 
  title="Plombier Woluwe-Saint-Lambert & Bruxelles | Urgence 24/7 en 30 Min"
  description="Entreprise de plomberie agréée à Bruxelles (Woluwe-Saint-Lambert). Dépannage fuite d'eau, débouchage express, boiler et sanitaire 24h/24. Devis gratuit au 0485 81 39 39."
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-content">
        <div class="hero-badge">
          <span class="live-indicator"></span>
          <span>Plombier Agréé Woluwe-Saint-Lambert & Bruxelles</span>
        </div>

        <h1 class="hero-title">
          Votre Plombier d'Urgence à <span class="text-gradient">Bruxelles</span> — Sur Place en 30 Min.
        </h1>

        <p class="hero-subtitle">
          Débouchage express, détection de fuite d'eau, réparation boiler et rénovation sanitaire. Artisans certifiés à <strong>Woluwe-Saint-Lambert</strong>, intervention 24h/7j avec <strong>devis préalable gratuit</strong>.
        </p>

        <!-- CTA Action Buttons -->
        <div class="hero-buttons">
          <a href="tel:0485813939" class="btn btn-accent btn-lg btn-pulse">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            <span>Urgence : 0485 81 39 39</span>
          </a>
          <a href="#simulateur" class="btn btn-primary btn-lg">
            <span>Calculer mon tarif en ligne</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

        <!-- Trust Badges -->
        <div class="hero-trust">
          <div class="trust-stars-wrap">
            <div class="stars">★★★★★</div>
            <span class="trust-rating"><strong>4.9 / 5</strong> (340+ avis Google & Trust)</span>
          </div>
          <div class="trust-features">
            <span class="trust-pill">⚡ Moins de 30 min</span>
            <span class="trust-pill">🛡️ Devis 100% garanti</span>
            <span class="trust-pill">📍 Woluwe-Saint-Lambert</span>
          </div>
        </div>
      </div>

      <!-- Hero Visual Image -->
      <div class="hero-visual">
        <div class="image-frame">
          <img 
            src="/images/hero-plumber.jpg" 
            alt="Plombier professionnel Stemaks inspectant un boiler à Woluwe-Saint-Lambert" 
            width="640" 
            height="400"
            loading="eager"
          />
          <div class="image-overlay-card">
            <div class="live-dot-wrap">
              <span class="live-indicator"></span>
              <strong>Équipes d'urgence en patrouille</strong>
            </div>
            <p>Délais moyens d'arrivée constatés à Woluwe : <strong>18 minutes</strong></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Statistics Banner -->
  <section class="stats-banner">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-item">
          <div class="stat-number">30<span class="stat-accent">min</span></div>
          <div class="stat-label">Délai d'intervention express</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">15<span class="stat-accent">+</span></div>
          <div class="stat-label">Années d'expérience certifiée</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">4 800<span class="stat-accent">+</span></div>
          <div class="stat-label">Dépannages réussis à Bruxelles</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">100<span class="stat-accent">%</span></div>
          <div class="stat-label">Devis gratuit sans surprise</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Estimator Section -->
  <section id="simulateur" class="section bg-slate">
    <div class="container">
      <PriceEstimator />
    </div>
  </section>

  <!-- Services Grid Section -->
  <section class="section">
    <div class="container">
      <div class="section-title-wrap">
        <span class="badge badge-primary">Nos Prestations</span>
        <h2>Services Complets de Plomberie & Chauffage</h2>
        <p>De l'urgence la plus critique au projet de rénovation sur mesure, découvrez nos solutions techniques à Bruxelles.</p>
      </div>

      <div class="grid-3">
        {services.map((item) => (
          <div class="card service-card">
            <div class="service-header">
              <div class="service-icon">{item.icon}</div>
              <span class="badge badge-dark">{item.delay}</span>
            </div>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
            <div class="service-footer">
              <span class="service-price">
                <small>Prix indicatif :</small>
                <strong>{item.price}</strong>
              </span>
              <a href={`/services#${item.id}`} class="btn btn-outline btn-sm">
                En savoir plus →
              </a>
            </div>
          </div>
        ))}
      </div>

      <div class="services-cta-wrap">
        <a href="/services" class="btn btn-primary btn-lg">
          Consulter le catalogue complet de nos services & tarifs →
        </a>
      </div>
    </div>
  </section>

  <!-- Why Choose Stemaks with Real Van Image -->
  <section class="section bg-dark why-section">
    <div class="container">
      <div class="why-grid">
        <div class="why-image-wrap">
          <img 
            src="/images/service-van.jpg" 
            alt="Fourgon d'intervention Stemaks Plomberie à Bruxelles Woluwe-Saint-Lambert" 
            width="640" 
            height="420"
            loading="lazy"
            class="why-img"
          />
          <div class="why-experience-badge">
            <span class="exp-years">15+</span>
            <span class="exp-text">Ans d'excellence à Woluwe</span>
          </div>
        </div>

        <div class="why-content">
          <span class="badge badge-accent">Pourquoi Stemaks ?</span>
          <h2>L'Artisan Plombier de Confiance des Bruxellois</h2>
          <p class="why-lead">
            Fini les mauvaises surprises et les surfacturations. Stemaks s'engage sur la ponctualité, l'honnêteté et la qualité irréprochable de chaque réparation.
          </p>

          <div class="features-list">
            <div class="feature-item">
              <div class="feature-icon">⚡</div>
              <div>
                <h4>Proximité & Rapidité Inégalée</h4>
                <p>Implantés Rue Abbé Jean Heymans à Woluwe-Saint-Lambert, nous arrivons chez vous en quelques minutes seulement.</p>
              </div>
            </div>

            <div class="feature-item">
              <div class="feature-icon">🛡️</div>
              <div>
                <h4>Tarification Claire & Transparente</h4>
                <p>Prix forfaitaires annoncés et validés avec vous avant tout début d'intervention. Pas de mauvaise surprise.</p>
              </div>
            </div>

            <div class="feature-item">
              <div class="feature-icon">🔬</div>
              <div>
                <h4>Équipement Haute Technologie</h4>
                <p>Caméras d'inspection endoscopique, furets motorisés et caméras thermiques pour localiser les pannes sans casser vos murs.</p>
              </div>
            </div>

            <div class="feature-item">
              <div class="feature-icon">📋</div>
              <div>
                <h4>Agréé Assurances & Garantie 10 Ans</h4>
                <p>Nos réparations sont couvertes par notre assurance décennale et certifiées pour un remboursement optimal.</p>
              </div>
            </div>
          </div>

          <div class="why-actions">
            <a href="tel:0485813939" class="btn btn-accent btn-lg">
              📞 Contacter un technicien : 0485 81 39 39
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Showcase Gallery Section -->
  <section class="section">
    <div class="container">
      <div class="section-title-wrap">
        <span class="badge badge-primary">Nos Réalisations Récentes</span>
        <h2>Excellence & Propreté sur Chaque Chantier</h2>
        <p>Aperçu de quelques-unes de nos interventions de rénovation et détection à Bruxelles.</p>
      </div>

      <div class="grid-2 showcase-grid">
        <div class="showcase-card">
          <div class="showcase-img-wrap">
            <img 
              src="/images/bathroom-renovation.jpg" 
              alt="Rénovation haut de gamme d'une salle de bain à Woluwe-Saint-Lambert" 
              width="600" 
              height="360"
              loading="lazy"
            />
            <span class="showcase-tag">Rénovation Sanitaire</span>
          </div>
          <div class="showcase-info">
            <h3>Rénovation Salle de Bain avec Douche Italienne</h3>
            <p>Quartier Georges Henri, Woluwe-Saint-Lambert. Remplacement baignoire par douche italienne, robinetterie encastrée noir mat et double vasque suspendue.</p>
          </div>
        </div>

        <div class="showcase-card">
          <div class="showcase-img-wrap">
            <img 
              src="/images/leak-detection.jpg" 
              alt="Détection de fuite non-destructive par caméra thermique à Bruxelles" 
              width="600" 
              height="360"
              loading="lazy"
            />
            <span class="showcase-tag">Recherche Non-Destructive</span>
          </div>
          <div class="showcase-info">
            <h3>Détection Fuite d'Eau par Caméra Thermique</h3>
            <p>Quartier Montgomery, Woluwe-Saint-Pierre. Localisation millimétrique d'une micro-fuite sur circuit de chauffage sous plancher sans démolir les dalles de marbre.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Verified Testimonials Section -->
  <section class="section bg-slate">
    <div class="container">
      <div class="section-title-wrap">
        <span class="badge badge-primary">Avis Clients Vérifiés</span>
        <h2>Ils Nous Font Confiance à Bruxelles</h2>
        <p>Plus de 340 ménages et syndics d'immeubles recommandent nos interventions.</p>
      </div>

      <div class="grid-3">
        {reviews.map((rev) => (
          <div class="card testimonial-card">
            <div class="testimonial-top">
              <div class="stars">★★★★★</div>
              <span class="review-date">{rev.date}</span>
            </div>
            <p class="review-comment">« {rev.comment} »</p>
            <div class="reviewer-meta">
              <div class="reviewer-avatar">
                {rev.name.charAt(0)}
              </div>
              <div>
                <strong class="reviewer-name">{rev.name}</strong>
                <span class="reviewer-commune">{rev.commune}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section with Schema Support -->
  <section class="section">
    <div class="container-narrow">
      <div class="section-title-wrap">
        <span class="badge badge-primary">Questions Fréquentes</span>
        <h2>Vos Questions sur nos Interventions Plomberie</h2>
        <p>Tout ce que vous devez savoir avant de faire appel à notre service à Bruxelles.</p>
      </div>

      <div class="faq-accordion">
        {faqs.map((item, index) => (
          <div class={`faq-item ${index === 0 ? 'active' : ''}`}>
            <button class="faq-question" type="button" aria-expanded={index === 0 ? 'true' : 'false'}>
              <span>{item.q}</span>
              <span class="faq-chevron">▼</span>
            </button>
            <div class="faq-answer">
              <p>{item.a}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="faq-bottom-cta">
        <p>Une question spécifique ou un problème particulier ?</p>
        <a href="tel:0485813939" class="btn btn-accent">
          📞 Appelez nos techniciens au 0485 81 39 39
        </a>
      </div>
    </div>
  </section>

  <!-- Final CTA Emergency Banner -->
  <section class="cta-banner">
    <div class="container cta-banner-inner">
      <div class="cta-text">
        <span class="badge badge-accent">Service d'Urgence Immédiat</span>
        <h2>Une Fuite d'Eau ou un WC Bouché à Bruxelles ?</h2>
        <p>Nos plombiers en patrouille sont prêts à intervenir à Woluwe-Saint-Lambert et dans tout Bruxelles sous 30 minutes.</p>
      </div>
      <div class="cta-action-group">
        <a href="tel:0485813939" class="btn btn-accent btn-lg btn-pulse">
          📞 0485 81 39 39 (Ligne Directe)
        </a>
        <a href="/contact" class="btn btn-white btn-lg">
          Demande de Devis Gratuit
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero Styles */
  .hero-section {
    padding-top: 3.5rem;
    padding-bottom: 4.5rem;
    background: radial-gradient(circle at 80% 20%, rgba(2, 132, 199, 0.08) 0%, transparent 60%);
    position: relative;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero-container {
      grid-template-columns: 1.15fr 0.95fr;
      gap: 4rem;
    }
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--primary-light);
    color: var(--primary-dark);
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full);
    margin-bottom: 1.25rem;
  }

  .hero-title {
    margin-bottom: 1.25rem;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--navy-700);
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .hero-subtitle strong {
    color: var(--navy-900);
  }

  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .hero-trust {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--slate-200);
  }

  .trust-stars-wrap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .trust-rating {
    font-size: 0.92rem;
    color: var(--navy-800);
  }

  .trust-features {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .trust-pill {
    font-size: 0.8rem;
    background: var(--slate-100);
    color: var(--navy-800);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    font-weight: 600;
  }

  /* Hero Visual */
  .hero-visual {
    position: relative;
  }

  .image-frame {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
    border: 3px solid var(--white);
  }

  .image-frame img {
    width: 100%;
    height: auto;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .image-frame:hover img {
    transform: scale(1.03);
  }

  .image-overlay-card {
    position: absolute;
    bottom: 1.25rem;
    left: 1.25rem;
    right: 1.25rem;
    background: rgba(15, 23, 42, 0.92);
    backdrop-filter: blur(12px);
    color: var(--white);
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .live-dot-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.2rem;
    font-size: 0.85rem;
    color: var(--slate-200);
  }

  .image-overlay-card p {
    font-size: 0.85rem;
    color: var(--slate-300);
    margin: 0;
  }

  .image-overlay-card strong {
    color: #38bdf8;
  }

  /* Stats Banner */
  .stats-banner {
    background: var(--white);
    border-block: 1px solid var(--slate-200);
    padding-block: 2.5rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    text-align: center;
  }

  @media (min-width: 768px) {
    .stats-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat-number {
    font-family: var(--font-heading);
    font-size: 2.6rem;
    font-weight: 800;
    color: var(--navy-900);
    line-height: 1;
    margin-bottom: 0.4rem;
  }

  .stat-accent {
    color: var(--primary);
  }

  .stat-label {
    font-size: 0.92rem;
    color: var(--navy-600);
    font-weight: 600;
  }

  /* Service Cards */
  .service-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .service-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .service-icon {
    font-size: 2.2rem;
  }

  .service-card h3 {
    margin-bottom: 0.6rem;
    font-size: 1.35rem;
  }

  .service-card p {
    font-size: 0.95rem;
    color: var(--navy-600);
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .service-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid var(--slate-100);
  }

  .service-price small {
    display: block;
    font-size: 0.75rem;
    color: var(--slate-500);
    text-transform: uppercase;
  }

  .service-price strong {
    font-size: 1.15rem;
    color: var(--primary-dark);
  }

  .btn-sm {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
  }

  .services-cta-wrap {
    text-align: center;
    margin-top: 3.5rem;
  }

  /* Why Choose Section */
  .why-section {
    padding-block: 6rem;
  }

  .why-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .why-grid {
      grid-template-columns: 1fr 1.1fr;
      gap: 5rem;
    }
  }

